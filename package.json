{
  "name": "botafogo-remotion-video",
  "version": "1.0.0",
  "private": true,
  "description": "Projeto Remotion em TypeScript para vídeo dinâmico do Botafogo com dados em JSON.",
  "scripts": {
    "preview": "remotion preview src/index.ts",
